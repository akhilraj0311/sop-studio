# You normally DON'T need to create this file: `bash deploy.sh YOUR_PROJECT_ID`
# writes .env for you (Firebase web config, bucket, seed key, app URL).
#
# Optional overrides you can put in .env before running deploy.sh:
# REGION=asia-south1
# SERVICE=sop-studio
# GEMINI_LOCATION=global
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-2.5-flash
#
# Use the Gemini Developer API instead of Vertex AI (key from https://aistudio.google.com/apikey):
# GEMINI_API_KEY=
